#STUDENT_EMAIL=your_email@example.com
#STUDENT_PASSWORD=your_password
NOTIFICATION_EMAIL=notification_email@gmail.com
NOTIFICATION_EMAIL_PASSWORD=your_app_password
GOOGLE_API_KEY=your_google_api_key

# Add multiple students using the `STUDENTS` variable.
# Supported formats:
# 1) CSV / semicolon list of email:password pairs (simple):
#    STUDENTS=student1@myuct.ac.za:pass1,student2@myuct.ac.za:pass2
#
# 2) JSON array (recommended for complex cases):
#    STUDENTS=[{"email":"student1@myuct.ac.za","password":"pass1"},{"email":"student2@myuct.ac.za","password":"pass2"}]

# Example (CSV form):
#STUDENTS=student1@myuct.ac.za:your_password1,student2@myuct.ac.za:your_password2
# Example (CSV form):
# - simple: email:password pairs
STUDENTS=student1@myuct.ac.za:your_password1,student2@myuct.ac.za:your_password2
# - with per-student notification email: email:password:notifyEmail
STUDENTS=student1@myuct.ac.za:your_password1:notify1@example.com,student2@myuct.ac.za:your_password2:notify2@example.com